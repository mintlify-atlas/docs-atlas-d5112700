  "keyFeatures": [
    "Client lifecycle management (natural and legal persons) with status tracking (pendiente, activo, moroso)",
    "Policy management with full state machine (COTIZADA → EN_TRAMITE → PENDIENTE_PAGO → VIGENTE)",
    "Automatic payment schedule generation based on policy frequency (monthly, quarterly, semi-annual, annual)",
    "Automated overdue detection via pg-boss background worker running nightly at 2:00 AM",
    "Multi-channel notifications (Email via Resend/SMTP, SMS via Twilio) with configurable reminder settings",
    "Role-based access control (admin, agente, supervisor, auditor, operador, cliente) with ABAC scoping",
    "Clean Architecture with Domain-Driven Design (Domain, Application, Infrastructure layers)",
    "Comprehensive audit logging for all successful and failed operations",
    "Docker-based deployment with PostgreSQL 15, Redis, Next.js web app, and background worker",
    "Dashboard with real-time KPIs: active policies, total clients, overdue payments, monthly revenue"
  ],
  "publicApiSurface": [
    "GET /api/clientes/[id] — Fetch client details with associated policies",
    "POST /api/auth/[...all] — Better-Auth authentication endpoints (login, session, logout)",
